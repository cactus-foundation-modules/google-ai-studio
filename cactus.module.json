{
  "name": "google-ai-studio",
  "version": "0.1.3",
  "tablePrefix": "gas_",
  "description": "Brings Google AI Studio to Cactus: paste in one API key and the site can make pictures for you and draft replies to your customers. With the Shop installed, a product's Images tab grows an AI photo section. With a mailbox or a contact form installed, every reply box grows a Suggest reply button that offers three drafts to choose from.",
  "requiresCoreVersion": "0.5.1574",
  "permissions": [
    "google-ai-studio.manage"
  ],
  "requiredEnvVars": [
    {
      "name": "ENCRYPTION_KEY",
      "required": true
    },
    {
      "name": "GOOGLE_AI_STUDIO_API_KEY",
      "required": false
    }
  ],
  "cookieCategories": [],
  "settingsTabs": [
    {
      "id": "google-ai-studio",
      "label": "Google AI Studio",
      "permission": "google-ai-studio.manage",
      "import": "./components/admin/SettingsTab",
      "component": "GoogleAiStudioSettingsTab"
    }
  ],
  "extensionPoints": [
    {
      "point": "core.reply-suggestions",
      "id": "google-ai-studio",
      "serverOnly": true,
      "import": "./lib/reply-suggestions",
      "component": "googleAiReplySuggester"
    },
    {
      "point": "shop.product-editor-media-sections",
      "id": "google-ai-studio-product-photos",
      "order": 20,
      "permission": "shop.products",
      "import": "./components/admin/ProductPhotosSection",
      "component": "ProductPhotosSection"
    }
  ],
  "teardown": [
    "gas_job_source_images",
    "gas_job_images",
    "gas_jobs",
    "gas_settings"
  ]
}
